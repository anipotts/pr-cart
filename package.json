{
  "name": "prcart",
  "version": "0.1.0",
  "private": true,
  "description": "Shop your pull requests. Keep what you need.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:download": "node scripts/check-patch-download.mjs",
    "cf:build": "next build && opennextjs-cloudflare build",
    "cf:preview": "wrangler dev",
    "cf:deploy": "pnpm run cf:build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.0",
    "framer-motion": "^11.0.0",
    "next": "^16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/canvas-confetti": "^1.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.148.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anipotts/pr-cart.git"
  },
  "author": "Ani Potts",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "undici@7": "^7.30.1",
      "glob@10": "^10.5.0",
      "sharp@0.35": "~0.35.5",
      "brace-expansion@2": "^2.1.7",
      "brace-expansion@5": "^5.0.12",
      "baseline-browser-mapping@2": "^2.11.0",
      "postcss@8": "^8.5.23",
      "form-data@4": "^4.0.6"
    }
  }
}
